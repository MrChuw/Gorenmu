# Translation for RandomLine
RandomLine-no_user_message = Não encontrei nenhuma mensagem de @{$name}.
RandomLine-no_channel_message = Não encontrei nenhuma mensagem do canal @{$channel_name}.
RandomLine-no_user_on_channel = Não encontrei nenhuma mensagem de @{$name} em @{$channel_name}.
RandomLine-search_timeout = 30s se passaram e não consegui encontrar uma mensagem do usuário @{$name} no canal @{$channel_name}
RandomLine-random_line = {$content} (enviado há {$time} por @{$nick} )

RandomLine-deco_helper = Pega uma mensagem aleatória do canal ou de um usuário em um canal.
RandomLine-deco_usage = Para usar: `{$prefix}rl channel:<nome do canal>` ou `{$prefix}rl user:<nome do usuário>` ou `{$prefix}rl` ou `{$prefix}rl channel:<nome do canal> user:<nome do usuário>`
RandomLine-deco_description = Este comando seleciona uma mensagem aleatória dependendo das opções fornecidas.

# Commands
RandomLine-cmd_res_curr_chan = (irá enviar uma mensagem aleatória do canal atual)
RandomLine-cmd_res_user_curr = (irá enviar uma mensagem aleatória do usuário no canal atual)
RandomLine-cmd_res_spec_chan = (irá enviar uma mensagem aleatória de um canal específico)
RandomLine-cmd_res_user_spec = (irá enviar uma mensagem aleatória de um usuário em um canal específico)
RandomLine-cmd_res_user_glob = (irá enviar uma mensagem aleatória de um usuário em todos os canais)
RandomLine-cmd_res_glob = (irá enviar uma mensagem aleatória de todos os canais)
