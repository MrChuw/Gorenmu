# Translation for RandomLine
RandomLine-no_user_message = Couldn't find any message from user @{$name}.
RandomLine-no_channel_message = Couldn't find any message from channel @{$channel_name}.
RandomLine-no_user_on_channel = Couldn't find any message from @{$name} in @{$channel_name}.
RandomLine-search_timeout = 30s has passed and I was unable to find a message from user @{$name} on channel @{$channel_name}
RandomLine-random_line = {$content} (sent {$time} ago by @{$nick} )

RandomLine-deco_helper = Fetches a random message from the channel or from a user in the channel.
RandomLine-deco_usage = to use: `{$prefix}rl channel:(channel_name)` or `{$prefix}rl user:(user_name)` or `{$prefix}rl` or `{$prefix}rl channel:(channel_name) user:(user_name)`
RandomLine-deco_description = This command selects a random message depending on the options provided.

# Commands
RandomLine-cmd_res_curr_chan = (it will send a random message from the current channel)
RandomLine-cmd_res_user_curr = (it will send a random message from the user on the current channel)
RandomLine-cmd_res_spec_chan = (it will send a random message from a specific channel)
RandomLine-cmd_res_user_spec = (it will send a random message from a user in a specific channel)
RandomLine-cmd_res_user_glob = (it will send a random message from a user in all channels)
RandomLine-cmd_res_glob = (it will send a random message from in a all channel)
