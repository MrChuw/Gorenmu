# Translation for Live
Live-never_streamed = Usuário {$name} nunca abriu nenhuma stream.
Live-response = {$args}
Live-title = Título: {$title}.
Live-last_stream = Última transmissão: {$time_natural} ({$time_precise}).
Live-stream_started = Transmissão iniciada: {$time_natural} ({$time_precise}).
Live-views = Visualizações: {$views}.
Live-playing = Jogando: {$game}.

Live-deco_helper = Mostra informações sobre a live atual ou a última de um canal.
Live-deco_usage = Como usar: {$prefix}live (canal ou id)
Live-deco_description = Exibe detalhes sobre a live atual ou a última do canal da Twitch especificado. Inclui título, tempo desde o início, visualizações, jogo e link do VOD se disponível. Se nenhum canal for especificado, usa o canal atual.

# Commands
Live-cmd_live_prefix = Canal ao vivo:
Live-cmd_live_res = Título: Cool Stream Title. || Transmissão iniciada: há um mês (1 mês, 1 dia, 1 hora). || Visualizações: 42069. || Jogando: Coolest Game. || https://www.twitch.tv/xXCoolNickXx https://www.twitch.tv/videos/1324
Live-cmd_off_prefix = Canal offline com VOD recente:
Live-cmd_off_res = Título: Cool Stream Title. || Última transmissão: há um mês (1 mês, 1 dia, 1 hora). || https://www.twitch.tv/xXCoolNickXx https://www.twitch.tv/videos/1324
