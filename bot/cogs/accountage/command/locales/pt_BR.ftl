AccountAge-accountage = { $mention } criou a conta em { $date } (há { $delta })
AccountAge-deco_helper = Verifica a data de criação de uma conta da Twitch.
AccountAge-deco_usage = Uso: { $prefix }accountage (nome_de_usuário)
AccountAge-deco_description = Retorna a data em que uma conta da Twitch foi criada e há quanto tempo isso aconteceu. Se nenhum nome for fornecido, verifica sua própria conta.

# Commands
AccountAge-cmd_ex1_args = accountage mr_chuw
AccountAge-cmd_ex1_res = @mr_chuw criou a conta em 20/01/2019 19:34:45 (há 6 anos).

AccountAge-cmd_ex2_args = accountage
AccountAge-cmd_ex2_res = @seu_nome criou a conta em 20/01/2019 19:34:45 (há 6 anos).
