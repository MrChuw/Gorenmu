# Translation for HyperTranslate
HyperTranslate-base_lang = en
HyperTranslate-starter_string = Translating the text…
HyperTranslate-unexpected_error = The text could not be translated.
HyperTranslate-translation = { $text }

HyperTranslate-deco_helper = Translates a text into random languages depending on how many times the user requests.
HyperTranslate-deco_usage = To use: { $prefix }hypertranslate (number of times) text
HyperTranslate-deco_description = Command based on [ravbug](https://www.ravbug.com/hypertranslate/) that translates a text into random languages depending on how many times the user requests.

# Commands
HyperTranslate-cmd_ex1_prefix = Multiple translation example.
HyperTranslate-cmd_ex1_args = 10 test
HyperTranslate-cmd_ex1_res = <some random text.>
