# Translation for LastSeen
LastSeen-bot = I am everywhere, at every moment...
LastSeen-author = you were last seen here ☝️
LastSeen-not_found = @{$name} has not been registered yet.
LastSeen-not_authorized = @{$name} was last seen {$delta}
LastSeen-last_seen = @{$name} was last seen in @{$channel}: {$content} ({$delta})

LastSeen-deco_helper = Used to see the last time a user was online.
LastSeen-deco_usage = Usage: {$prefix}lastseen (user)
LastSeen-deco_description = Command used to check when a user was last seen in a chat.

# Commands
LastSeen-cmd_ex1_res = @channel_name was last seen in @other_channel: Message content (1 day ago)
LastSeen-cmd_ex2_res = @user_nick was last seen in @other_channel: Message content (2 days ago)

# Admonitions
LastSeen-adm_title = User Mention
LastSeen-adm_msg = If the user has disabled mentions, the content of the last message and exact time will not be shown.
