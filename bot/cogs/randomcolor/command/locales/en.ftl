# Translation for RandomColor
RandomColor-api_down = thecolorapi.com is inaccessible
RandomColor-response_url = {$hex_code} is {$name}. {$url}

RandomColor-deco_helper = Sends a random color.
RandomColor-deco_usage = To use: {$prefix}random_color or add type:hex / type:rgb to specify the type.
RandomColor-deco_description = This command responds with the HEX code of a random color and a link to an image of the color.

# Commands
RandomColor-cmd_res = #<HEX> <Color Name> <Link to the color image>
