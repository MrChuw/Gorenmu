# Translation for ProfilePicture
ProfilePicture-deco_helper = Shows a user's Twitch profile image.
ProfilePicture-deco_usage = How to use: {$prefix}profilepicture (username)
ProfilePicture-deco_description = This command fetches the profile picture of the specified Twitch user in high resolution. If no username is given, it uses the command author. The image is uploaded and returned with a short link.

# Commands
ProfilePicture-cmd_res = https://twitch-cdn.example.com/profile.png https://short.url/pic
