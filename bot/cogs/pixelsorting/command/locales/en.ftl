# Translation for PixelSorting
PixelSorting-no_url = No valid URL provided.
PixelSorting-invalid_content_type = Only real image files (like .jpg, .png) are accepted, no previews or unsupported links.
PixelSorting-took_too_long = {$time} seconds have passed and the process has not finished. Try a smaller image or less types.
PixelSorting-image = {$shortened}

PixelSorting-deco_helper = Command used to make basic pixel sorting in images.
PixelSorting-deco_usage = To use: {$prefix}pxs (url or shortened direct link)
PixelSorting-deco_description = This command processes an image using pixel sorting algorithms. You can specify the color mode, intensity, direction, crop tiles, randomization, and masking options.

# Commands
PixelSorting-cmd_no_args_prefix = An image URL with no default arguments.
PixelSorting-cmd_args_prefix = An image URL with with arguments.
PixelSorting-cmd_url_arg = (image url)
PixelSorting-cmd_full_args = type:red crop:100px:100px maskmode:internal dire:horizontal
PixelSorting-cmd_res = (link for the image.)

# Admonitions
PixelSorting-adm_modes_title = Multiple Sorting Modes
PixelSorting-adm_modes_msg = You can use modes like red, green, blue, sum, rgb, hue, saturation, value, luma, and more.
PixelSorting-adm_mask_title = Masking Options
PixelSorting-adm_mask_msg = You can control which pixels are affected using [maskmode:internal|external] and [maskthreshold:128].
PixelSorting-adm_rand_title = Random Segments
PixelSorting-adm_rand_msg = Set [rand:true] to introduce randomness into which segments are sorted.
PixelSorting-adm_res_title = Max Resolution
PixelSorting-adm_res_msg = Images larger than 1920x1080 will be resized automatically.
