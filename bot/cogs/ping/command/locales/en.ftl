# Translation for Ping
Ping-ping = {$ping} || TMI: {$tmi} || RAM: {$mem} || {$started}

Ping-deco_helper = Command to check if the bot is alive.
Ping-deco_usage = How to use: {$prefix1}ping or {$prefix2}pong
Ping-deco_description = This command measures the bot's response time, shows memory usage, and how long the bot has been online.

# Commands
Ping-cmd_res = pong 🏓 || TMI: 123 ms || RAM: 123 MB || up for 1 hour

# Admonitions
Ping-adm_tmi_title = TMI
Ping-adm_tmi_msg = TMI stands for Internal Message Time — the time between the message being sent and the bot replying.
Ping-adm_ram_title = RAM
Ping-adm_ram_msg = Shows how much RAM memory the current bot process is using.
Ping-adm_up_title = Uptime
Ping-adm_up_msg = Shows how long the bot has been online since the last boot.
