# Translation for Fight
Fight-bot_nick = You would never be able to defeat me in a fight.
Fight-yourself = Please seek help.
Fight-start = @{$name} Do you accept the fight? (yes/no in chat)
Fight-refused = @{$target} refused to fight {$user}.
Fight-timeout = 10s passed and @{$target} decided not to accept the fight.
Fight-options =
    @{$name1} finishes {$name2}!
    @{$name1} knocks {$name2} unconscious!
    @{$name1} defeats {$name2} easily!
    @{$name1} beats {$name2} mercilessly!
    @{$name1} leaves no chance for {$name2} and wins!
    @{$name1} almost loses, but takes {$name2} down!
    @{$name1} wins the fight against {$name2}!
    @{$name1} defeats {$name2} with difficulty!
    @{$name1} wins against {$name2} in a close fight!
    @{$name1} easily beats {$name2}!

Fight-deco_helper = fight someone.
Fight-deco_usage = To use: {$prefix}fight (username)
Fight-deco_description = fight someone.

