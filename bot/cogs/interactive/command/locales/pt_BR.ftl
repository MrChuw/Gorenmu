# Translation for Fight
Fight-bot_nick = Você jamais seria capaz de me derrotar numa luta.
Fight-yourself = Por favor, procure ajuda.
Fight-start = @{$name} Você aceita a luta? (sim/não no chat)
Fight-refused = @{$target} recusou-se a lutar contra {$user}.
Fight-timeout = Passaram-se 10s e @{$target} decidiu não aceitar a luta.
Fight-options =
    @{$name1} acaba com {$name2}!
    @{$name1} deixa {$name2} desacordado!
    @{$name1} derrota {$name2} facilmente!
    @{$name1} espanca {$name2} sem piedade!
    @{$name1} não dá chances para {$name2} e vence!
    @{$name1} quase perde, mas derruba {$name2}!
    @{$name1} vence a luta contra {$name2}!
    @{$name1} vence {$name2} com dificuldades!
    @{$name1} vence {$name2} em uma luta acirrada!
    @{$name1} vence {$name2} facilmente!

Fight-deco_helper = Lute com alguém.
Fight-deco_usage = Para usar: {$prefix}fight (username)
Fight-deco_description = Lute com alguém.

