# Translation for Imgur
Imgur-time = Time: { $time }
Imgur-all_images = All generated images: { $embed_url }
Imgur-all_images2 = || All images: { $embed_url }
Imgur-took_too_long = { $passed }s has passed and I haven't been able to generate the image(s).

Imgur-deco_helper = Command used to generate random images from Imgur. NSFW command disabled by default.
Imgur-deco_usage = To use: { $prefix }imgur(7) (amount)
Imgur-deco_description = Command used to generate random images from Imgur. NSFW command disabled by default.

# Commands
Imgur-cmd_ex1_prefix = Generate 5 random images.
Imgur-cmd_ex1_res = [Links of generated images]

# Admonitions
Imgur-adm_warn_title = Disabled by default.
Imgur-adm_warn_msg = Because this command can generate NSFW images, it is disabled by default.
