# Translation for Echo
Echo-echo = { $args }

Echo-deco_helper = Repeats the message you send.
Echo-deco_usage = { $prefix }echo (message)
Echo-deco_description = Sends back the same message provided by the user.

# Admonitions
Echo-adm_title = Punctuations!
Echo-adm_msg = If any type of punctuation is placed at the beginning of the message, an invisible character will be inserted to prevent the use of commands.
