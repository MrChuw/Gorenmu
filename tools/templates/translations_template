        def deco_commands(self, *args, **kwargs) -> CommandExemples:
            with self.lang_dict.once(self._cname):
                self.lang_dict.add_with("en", CommandExemples([]))
                self.lang_dict.add_with(["pt_br", "pt"], CommandExemples([]))
