from __future__ import annotations

from typing import TYPE_CHECKING

from bot.ext import Admonitions, CommandExemples, Response, TBase, TranslationBase, TranslationEntry


if TYPE_CHECKING:
    from bot.bot import Gorenmu
    from .{command_name} import {command_title}Cmd


class Translations(TranslationBase):
    def __init__(self, bot: Gorenmu, parent: {command_title}Cmd) -> None:
        super().__init__(bot, __file__)
        self.parent: {command_title}Cmd = parent
        self.populate_subclasses(parent=self)

    class {command_title}(TBase):
        def __init__(self, parent: Translations):
            super().__init__(parent)
            self.prefix = "{command_title}"

        def placeholder(self, **kwargs) -> Response:
            text = self.get_text(self._cname, **kwargs)
            return Response(ctx=self.ctx_get(), success=True, response_string=text)

        def placeholder_error(self, **kwargs) -> Response:
            text = self.get_text(self._cname, **kwargs)
            return Response(ctx=self.ctx_get(), success=False, response_string=text)

        def placeholder_entry(self, **kwargs) -> str | TranslationEntry:
            if not kwargs:
                return self.get_entry(self._cname)
            return self.get_text(self._cname, **kwargs)

        def placeholder_list(self, **kwargs) -> list[str]:
            return self.get_list(self._cname, **kwargs)

        def placeholder_attributes_list(self, **kwargs) -> list[str]:
            return self.get_attributes_list(self._cname)

        # --- Help Methods ---

        def deco_helper(self, *args, **kwargs) -> str:
            return self.get_text(self._cname)

        def deco_usage(self, prefix: str | None = None, *args, **kwargs) -> str:
            return self.get_text(self._cname, prefix=prefix)

        # region Hide.

        def deco_description(self, *args, **kwargs) -> str:
            return self.get_text(self._cname)

        def deco_commands(self, *args, **kwargs) -> CommandExemples:
            return CommandExemples(
                [
                    {
                        "prefix": self.get_text("cmd_ex1_prefix"),
                        "args": "exemplo_arg",
                        "response": self.get_text("cmd_ex1_res"),
                    },
                ]
            )

        def deco_admonitions(self, *args, **kwargs) -> Admonitions:
            return Admonitions(
                [
                    {
                        "admonition_type": "info",
                        "position": "top",
                        "title": self.get_text("adm_title"),
                        "message": self.get_text("adm_msg"),
                    }
                ]
            )

        # endregion

    {command_title}: {command_title}
